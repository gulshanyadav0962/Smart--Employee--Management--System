@model IEnumerable<Smart_Employee_Management_System.Models.Review>

@{
    ViewData["Title"] = "Review List";
}

<h2>Review List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Review</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Worker</th>
            <th>Rating</th>
            <th>Comment</th>
            <th>Review Date</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Customer?.FullName</td>
                <td>@item.Worker?.FullName</td>
                <td>@item.Rating ⭐</td>
                <td>@item.Comment</td>
                <td>@item.ReviewDate.ToShortDateString()</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>