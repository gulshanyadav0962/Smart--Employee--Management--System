@model Smart_Employee_Management_System.Models.Review

@{
    ViewData["Title"] = "Delete Review";
}

<h2>Delete Review</h2>

<h4>Are you sure you want to delete this review?</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">Customer</dt>
    <dd class="col-sm-9">@Model.Customer?.FullName</dd>

    <dt class="col-sm-3">Worker</dt>
    <dd class="col-sm-9">@Model.Worker?.FullName</dd>

    <dt class="col-sm-3">Rating</dt>
    <dd class="col-sm-9">@Model.Rating ⭐</dd>

    <dt class="col-sm-3">Comment</dt>
    <dd class="col-sm-9">@Model.Comment</dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>