@model Smart_Employee_Management_System.Models.Booking

@{
    ViewData["Title"] = "Edit Booking";
}

<h2>Edit Booking</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="CustomerId" class="form-label"></label>
        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-control">
            <option value="">-- Select Customer --</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="WorkerId" class="form-label"></label>
        <select asp-for="WorkerId" asp-items="ViewBag.Workers" class="form-control">
            <option value="">-- Select Worker --</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="BookingDate" class="form-label"></label>
        <input asp-for="BookingDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="WorkDate" class="form-label"></label>
        <input asp-for="WorkDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <input asp-for="Status" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="TotalAmount" class="form-label"></label>
        <input asp-for="TotalAmount" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">
        Update Booking
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}