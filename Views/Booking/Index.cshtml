@model IEnumerable<Smart_Employee_Management_System.Models.Booking>

@{
    ViewData["Title"] = "Booking List";
}

<h2>Booking List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Booking</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Worker</th>
            <th>Booking Date</th>
            <th>Work Date</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Customer.FullName</td>
                <td>@item.Worker.FullName</td>
                <td>@item.BookingDate.ToShortDateString()</td>
                <td>@item.WorkDate.ToShortDateString()</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>