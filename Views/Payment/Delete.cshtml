@model Smart_Employee_Management_System.Models.Payment

@{
    ViewData["Title"] = "Delete Payment";
}

<h2>Delete Payment</h2>

<h4>Are you sure you want to delete this payment?</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">Booking ID</dt>
    <dd class="col-sm-9">@Model.BookingId</dd>

    <dt class="col-sm-3">Amount</dt>
    <dd class="col-sm-9">@Model.Amount</dd>

    <dt class="col-sm-3">Payment Method</dt>
    <dd class="col-sm-9">@Model.PaymentMethod</dd>

    <dt class="col-sm-3">Payment Status</dt>
    <dd class="col-sm-9">@Model.PaymentStatus</dd>

    <dt class="col-sm-3">Transaction ID</dt>
    <dd class="col-sm-9">@Model.TransactionId</dd>

    <dt class="col-sm-3">Payment Date</dt>
    <dd class="col-sm-9">@Model.PaymentDate.ToShortDateString()</dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>