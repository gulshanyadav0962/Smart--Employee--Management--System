@model IEnumerable<Smart_Employee_Management_System.Models.Worker>

@{
    ViewData["Title"] = "Find Worker";
}

<h2>Find Worker</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Mobile</th>
            <th>Address</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.Category?.Name</td>
                <td>@item.MobileNumber</td>
                <td>@item.Address</td>
                <td>
                    <a asp-controller="Booking"
                       asp-action="Create"
                       asp-route-workerId="@item.Id"
                       class="btn btn-success">
                        Book Now
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>