@model Smart_Employee_Management_System.Models.Worker

<h2>Delete Worker</h2>

<h4>Are you sure you want to delete this worker?</h4>

<hr />

<dl class="row">
    <dt class="col-sm-3">Full Name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Mobile Number</dt>
    <dd class="col-sm-9">@Model.MobileNumber</dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@Model.Category?.Name</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>